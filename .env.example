# ==============================================================================
# AGENT BAAL - TACTICAL C4I MISSION CONTROL TEMPLATE (.env.example)
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# --- AI & Reasoning Engine ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Real-Time Weather & OSINT Providers ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_API_KEY=your_weatherapi_key_here
TOMORROW_IO_API_KEY=your_tomorrow_io_api_key_here
VITE_TOMORROW_IO_API_KEY=your_tomorrow_io_api_key_here
OSINT_FEED_URL=https://api.weather.gov

# --- Mission Control & Database Paths ---
ASSETS_DB_PATH=assets_db.json
C4I_ENVIRONMENT=simulation
C4I_LOG_LEVEL=INFO

# --- Tactical Risk Thresholds ---
ALERT_SEVERITY_THRESHOLD=CRITICAL
DEFAULT_CONFIDENCE_THRESHOLD=85
SAFE_HAVEN_SEARCH_RADIUS_KM=150.0
